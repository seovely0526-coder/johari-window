rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['owner','self','createdAt'])
                    && request.resource.data.owner is string
                    && request.resource.data.owner.size() <= 20;
      allow update: if request.resource.data.owner == resource.data.owner
                    && request.resource.data.self is list
                    && request.resource.data.feedback is list;
      match /feedback/{feedbackId} {
        allow read, create: if true;
        allow update, delete: if false;
      }
    }
  }
}