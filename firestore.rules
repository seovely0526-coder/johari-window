rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'seovely0526@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function validAnswers(a) {
      return a is map
        && a.keys().hasAll([
          'selfAwareness',
          'feedbackComfort',
          'otherUnderstanding',
          'relationship',
          'futureUse'
        ])
        && a.keys().hasOnly([
          'selfAwareness',
          'feedbackComfort',
          'otherUnderstanding',
          'relationship',
          'futureUse'
        ])
        && a.selfAwareness is int
        && a.selfAwareness >= 1 && a.selfAwareness <= 5
        && a.feedbackComfort is int
        && a.feedbackComfort >= 1 && a.feedbackComfort <= 5
        && a.otherUnderstanding is int
        && a.otherUnderstanding >= 1 && a.otherUnderstanding <= 5
        && a.relationship is int
        && a.relationship >= 1 && a.relationship <= 5
        && a.futureUse is int
        && a.futureUse >= 1 && a.futureUse <= 5;
    }

    match /rooms/{roomId} {
      // 공유 링크로 방과 피드백을 확인하는 현재 기능을 위한 공개 읽기입니다.
      // 방 문서에는 실명, 연락처 등 민감한 정보를 저장하지 마세요.
      allow read: if true;

      allow create: if
        request.resource.data.keys().hasAll([
          'owner', 'self', 'createdAt', 'feedback'
        ])
        && request.resource.data.keys().hasOnly([
          'owner', 'self', 'createdAt', 'feedback'
        ])
        && request.resource.data.owner is string
        && request.resource.data.owner.size() >= 1
        && request.resource.data.owner.size() <= 20
        && request.resource.data.self is list
        && request.resource.data.self.size() == 0
        && request.resource.data.createdAt is int
        && request.resource.data.feedback is list
        && request.resource.data.feedback.size() == 0;

      allow update: if
        request.resource.data.owner == resource.data.owner
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (
            request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['self'])
            && request.resource.data.self is list
            && request.resource.data.self.size() >= 3
            && request.resource.data.self.size() <= 5
          )
          ||
          (
            request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['feedback'])
            && request.resource.data.feedback is list
            && request.resource.data.feedback.size()
              == resource.data.feedback.size() + 1
            && request.resource.data.feedback.size() <= 100
          )
        );

      allow delete: if isAdmin();
    }

    match /surveyResponses/{responseId} {
      allow create: if
        request.resource.data.keys().hasAll([
          'answers', 'isTest', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'answers', 'isTest', 'createdAt'
        ])
        && validAnswers(request.resource.data.answers)
        && request.resource.data.createdAt == request.time
        && (
          request.resource.data.isTest == false
          || (
            isAdmin()
            && request.resource.data.isTest == true
          )
        );

      allow read: if isAdmin();
      allow update: if false;
      allow delete: if
        isAdmin()
        && resource.data.isTest == true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
