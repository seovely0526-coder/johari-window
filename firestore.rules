rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 관리자 인증 확인
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'seovely0526@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // 조하리의 창 활동방
    match /rooms/{roomId} {

      // 활동방 정보와 피드백을 읽을 수 있음
      allow read: if true;

      // 활동방 생성 시 필수 필드 및 데이터 형식 확인
      allow create: if
        request.resource.data.keys().hasAll([
          'owner',
          'self',
          'createdAt',
          'feedback'
        ])
        && request.resource.data.owner is string
        && request.resource.data.owner.size() <= 20
        && request.resource.data.self is list
        && request.resource.data.self.size() <= 5
        && request.resource.data.createdAt is int
        && request.resource.data.feedback is list
        && request.resource.data.feedback.size() == 0;

      // 기존 활동방의 소유자, 자기 평가, 생성 시간은 변경 불가
      // 피드백만 추가할 수 있음
      allow update: if
        request.resource.data.owner == resource.data.owner
        && request.resource.data.self == resource.data.self
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['feedback'])
        && request.resource.data.feedback is list
        && request.resource.data.feedback.size()
             <= resource.data.feedback.size() + 1;

      // 활동방 삭제는 관리자만 가능
      allow delete: if isAdmin();
    }

    // 익명 설문 응답
    match /surveyResponses/{responseId} {

      // 설문 응답 제출
      allow create: if
        request.resource.data.keys().hasAll([
          'answers',
          'createdAt',
          'isTest'
        ])
        && request.resource.data.answers is list
        && request.resource.data.answers.size() == 5
        && request.resource.data.createdAt is int
        && request.resource.data.isTest is bool;

      // 응답 통계 조회는 관리자만 가능
      allow read: if isAdmin();

      // 응답 수정은 허용하지 않음
      allow update: if false;

      // 테스트 응답 삭제는 관리자만 가능
      // 실제 응답은 삭제하지 않음
      allow delete: if isAdmin()
        && resource.data.isTest == true;
    }

    // 그 외 모든 데이터 접근 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
